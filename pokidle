#!/usr/bin/env bash
# pokidle — passive pokemon encounter daemon + CLI.

set -Eeuo pipefail

# readlink -f resolves the symlink chain so invoking via e.g. ~/.local/bin/pokidle
# still finds lib/ next to the real script.
POKIDLE_REPO_ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
export POKIDLE_REPO_ROOT

: "${POKIDLE_CONFIG_DIR:=${XDG_CONFIG_HOME:-${HOME}/.config}/pokidle}"
: "${POKIDLE_CACHE_DIR:=${XDG_CACHE_HOME:-${HOME}/.cache}/pokidle}"
: "${POKIDLE_DATA_DIR:=${XDG_DATA_HOME:-${HOME}/.local/share}/pokidle}"
: "${POKIDLE_DB_PATH:=${POKIDLE_DATA_DIR}/pokidle.db}"
: "${POKIDLE_POKEAPI_RATE_LIMIT_SLEEP:=0.5}"
export POKIDLE_CONFIG_DIR POKIDLE_CACHE_DIR POKIDLE_DATA_DIR POKIDLE_DB_PATH POKIDLE_POKEAPI_RATE_LIMIT_SLEEP

# Shared libraries under lib/. Sourced by glob, same as commands/ below. Load
# order is alphabetical and does not matter: every lib body is functions
# (resolved at call time) or self-contained file-scope (env-var defaults,
# array literals). The few real cross-lib dependencies self-heal via a
# `command -v <fn> || source <lib>` guard at the top of the dependent lib, so
# they load their prerequisite regardless of glob order.
for _lib_file in "${POKIDLE_REPO_ROOT}"/lib/*.bash; do
    [[ -e "${_lib_file}" ]] || continue
    # shellcheck source=/dev/null
    source "${_lib_file}"
done
unset _lib_file

# Each subcommand lives in its own file under commands/, defining pokidle_<cmd>
# (the implementation, which parses its own flags and handles -h/--help via
# pokidle_<cmd>_help). Sourced here — before the dispatch and unconditionally, so
# the functions exist for both the CLI and the test harness. Command bodies may
# call shared _pokidle_* helpers defined below; bash resolves those at call time.
for _cmd_file in "${POKIDLE_REPO_ROOT}"/commands/*.bash; do
    [[ -e "${_cmd_file}" ]] || continue
    # shellcheck source=/dev/null
    source "${_cmd_file}"
done
unset _cmd_file

# usage
# Print the terse top-level help. Each command carries its own detailed help,
# shown by `pokidle <command> --help`.
function usage {
    cat <<'EOF'
pokidle — passive Pokémon encounter daemon.

Usage:
  pokidle <command> [args...]

Commands:
  daemon         Daemon lifecycle (run loop + start/stop/status/logs/…)
  tick           Run a single roll now (encounter/item/level/evolve/…)
  encounters     List recorded Pokémon encounters
  export         Build a random Pokémon Showdown team
  items          List item drops
  log            Recent tick event log
  stats          Aggregate encounter statistics
  current        Active biome status and candidate pools
  rebuild-pool   Regenerate biome encounter pools
  switch-biome   Close the active session, open a new one
  biomes         List the biome catalog
  clean          Wipe caches and/or the database
  setup          Install + enable the systemd unit
  uninstall      Disable + remove the unit (data untouched)
  help           This command list.

Run 'pokidle <command> --help' for command-specific options.
EOF
}

# Tests source the script for unit testing helper functions.
if [[ "${POKIDLE_TEST_SOURCE_ONLY:-0}" == "1" ]]; then
    POKIDLE_TEST_SKIP_DISPATCH=1
fi

if [[ "${POKIDLE_TEST_SKIP_DISPATCH:-0}" == "0" ]]; then
    cmd="${1-}"
    if [[ -z "${cmd}" ]]; then
        usage >&2
        exit 2
    fi
    shift

    case "${cmd}" in
        daemon) pokidle_daemon "$@" ;;
        tick) pokidle_tick "$@" ;;
        encounters) pokidle_list "$@" ;;
        export) pokidle_export "$@" ;;
        items) pokidle_items "$@" ;;
        log) pokidle_log "$@" ;;
        stats) pokidle_stats "$@" ;;
        current) pokidle_current "$@" ;;
        rebuild-pool) pokidle_rebuild_pool "$@" ;;
        switch-biome) pokidle_switch_biome "$@" ;;
        biomes) pokidle_biomes "$@" ;;
        clean) pokidle_clean "$@" ;;
        setup) pokidle_setup "$@" ;;
        uninstall) pokidle_uninstall "$@" ;;
        help | -h | --help) usage ;;
        *)
            printf 'unknown command: %s\n' "${cmd}" >&2
            usage >&2
            exit 2
            ;;
    esac
fi
